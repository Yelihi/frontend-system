{
  "id": "ticket-selection",
  "title": "실제 v12 티켓 프로젝트 · React와 외부 store",
  "basis": "observed",
  "summary": "버튼 클릭부터 ticketStore 변경, 구독 중인 두 페이지의 snapshot 읽기와 표시 의존성을 추적합니다.",
  "scope": {
    "files": [
      "package.json",
      "README.md",
      "src/Pages.tsx",
      "src/Button.tsx",
      "src/store.ts"
    ],
    "discoveryRoots": [
      "src"
    ],
    "discoveryMode": "source"
  },
  "evidence": {
    "tickets": {
      "path": "src/Pages.tsx",
      "quote": "export function TicketsPage(){const selected=useSyncExternalStore(ticketStore.subscribe,ticketStore.getSnapshot,ticketStore.getSnapshot);return <section><Button size=\"small\" tone=\"neutral\" onClick={()=>ticketStore.select('t1')}>Choose ticket</Button><Indicator active={selected==='t1'}/></section>;}"
    },
    "details": {
      "path": "src/Pages.tsx",
      "quote": "export function TicketDetailsPage(){const selected=useSyncExternalStore(ticketStore.subscribe,ticketStore.getSnapshot,ticketStore.getSnapshot);return <article aria-live=\"polite\">{selected||'No selection'}</article>;}"
    },
    "props": {
      "path": "src/Button.tsx",
      "quote": "type Props={size:'small'|'large';tone:'neutral'|'danger';onClick:()=>void;children:React.ReactNode};"
    },
    "button": {
      "path": "src/Button.tsx",
      "quote": "export function Button({size,tone,onClick,children}:Props){return <button type=\"button\" onClick={onClick} className={styles.base+' '+(size==='small'?'text-sm':'text-lg')+' '+(tone==='danger'?'bg-red-600 text-white':'bg-gray-100 text-black')}>{children}</button>;}"
    },
    "indicator": {
      "path": "src/Button.tsx",
      "quote": "export function Indicator({active}:{active:boolean}){return <span className={active?'opacity-100':'opacity-50'}>Selected</span>;}"
    },
    "state": {
      "path": "src/store.ts",
      "quote": "let selected=''; const listeners=new Set<()=>void>();"
    },
    "snapshot": {
      "path": "src/store.ts",
      "quote": "getSnapshot:()=>selected"
    },
    "subscribe": {
      "path": "src/store.ts",
      "quote": "subscribe:(f:()=>void)=>{listeners.add(f);return()=>{listeners.delete(f);}}"
    },
    "select": {
      "path": "src/store.ts",
      "quote": "select:(id:string)=>{selected=id;listeners.forEach(f=>f());}"
    }
  },
