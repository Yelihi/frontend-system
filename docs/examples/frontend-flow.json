{
  "id": "order-editor",
  "title": "주문 편집 · 페이지와 상태의 연결",
  "basis": "proposed",
  "summary": "페이지 안의 컴포넌트와 외부 상태를 함께 보고, 이벤트별로 영향을 받는 블록을 따라갑니다. 아래는 표현 방식 검토를 위한 설계 예시입니다.",
  "scope": {
    "files": [
      "docs/examples/frontend-flow.json"
    ],
    "discoveryRoots": [
      "docs/examples"
    ]
  },
  "evidence": {},
  "nodes": [
    {
      "id": "edit-page",
      "kind": "page",
      "label": "OrderEditPage · /orders/:id/edit",
      "evidence": [],
      "state": [
        "orderId: OrderId"
      ],
      "lifecycle": [
        "mount → draftStore.initialize(order)",
        "unmount → orderClient.abort(owner)"
      ]
    },
    {
      "id": "form",
      "kind": "component",
      "label": "OrderForm",
      "evidence": [],
      "props": [
        "orderId: OrderId",
        "onSubmit: (input: OrderDraft) => Promise<SaveResult>"
      ],
      "state": [
        "fieldErrors: Record<string, string>",
        "pending: boolean"
      ],
      "events": [
        "onQuantityChange(value: number)",
        "onSubmit(input: OrderDraft)",
        "onCancel()"
      ],
      "lifecycle": [
        "mount → draftStore.subscribe(onDraftChange)",
        "unmount → unsubscribe()"
      ],
      "parent": "edit-page",
      "contracts": [
        {
          "kind": "interface",
          "name": "OrderFormProps",
          "path": "src/components/OrderForm.tsx",
          "signature": "interface OrderFormProps {\n  orderId: OrderId;\n  onSubmit(input: OrderDraft): Promise<SaveResult>;\n}",
          "evidence": []
        }
      ]
    },
    {
      "id": "preview",
      "kind": "component",
      "label": "PricePreview",
      "evidence": [],
      "props": [
        "currency: string"
      ],
      "state": [
        "total: number = calculateTotal(draft)"
      ],
      "lifecycle": [
        "draftStore.subscribe(onDraftChange) → calculateTotal(draft)"
      ],
      "parent": "edit-page"
    },
    {
      "id": "list-page",
      "kind": "page",
      "label": "OrdersPage · /orders",
      "evidence": [],
      "state": [
        "filter: OrderFilter"
      ],
      "lifecycle": [
        "mount → orderQueryCache.subscribe(filter, onOrdersChange)"
      ]
    },
    {
      "id": "table",
      "kind": "component",
      "label": "OrdersTable",
      "evidence": [],
      "props": [
        "filter: OrderFilter"
      ],
      "state": [
        "rows: ReadonlyArray<Order>"
      ],
      "events": [
        "onEdit(orderId: OrderId)"
      ],
      "lifecycle": [
        "orderQueryCache.subscribe(filter, onOrdersChange)",
        "unmount → unsubscribe()"
      ],
      "parent": "list-page"
    },
    {
      "id": "draft",
      "kind": "store",
      "label": "draftStore",
      "evidence": [],
      "state": [
        "quantity: number",
        "unitPrice: number",
        "dirty: boolean"
      ],
      "events": [
        "setQuantity(value: number): void",
        "markSaved(owner: string): void"
      ]
    },
    {
      "id": "domain",
      "kind": "module",
      "label": "OrderPolicy",
      "evidence": [],
      "events": [
        "validateQuantity(input: OrderDraft): Record<string, string>",
        "calculateTotal(input: OrderDraft): number"
      ],
      "state": [],
      "contracts": [
        {
          "kind": "type",
          "name": "OrderId",
          "path": "src/domain/order.ts",
          "signature": "type OrderId = string",
          "evidence": []
        },
        {
          "kind": "interface",
          "name": "Order",
          "path": "src/domain/order.ts",
          "signature": "interface Order {\n  id: OrderId;\n  quantity: number;\n  unitPrice: number;\n}",
          "evidence": []
        },
        {
          "kind": "type",
          "name": "OrderDraft",
          "path": "src/domain/order.ts",
          "signature": "type OrderDraft = Pick<Order, 'id' | 'quantity' | 'unitPrice'>",
          "evidence": []
        }
      ]
    },
    {
      "id": "cache",
      "kind": "cache",
      "label": "orderQueryCache",
      "evidence": [],
      "state": [
        "orders: ReadonlyArray<Order>",
        "rollbackSnapshot: ReadonlyArray<Order> | null",
        "requestOwner: string | null"
      ],
      "events": [
        "optimisticWrite(input: OrderDraft, owner: string)",
        "commit(order: Order, owner: string)",
        "rollback(owner: string)",
        "invalidate(orderId: OrderId)"
      ]
    },
    {
      "id": "api",
      "kind": "service",
      "label": "orderClient",
      "evidence": [],
      "events": [
        "saveOrder(input: OrderDraft, signal: AbortSignal): Promise<SaveResult>"
      ],
      "state": [],
      "contracts": [
        {
          "kind": "type",
          "name": "SaveResult",
          "path": "src/application/save-order.ts",
          "signature": "type SaveResult =\n  | { ok: true; order: Order }\n  | { ok: false; message: string }",
          "evidence": []
        },
        {
          "kind": "function",
          "name": "saveOrder",
          "path": "src/application/save-order.ts",
          "signature": "saveOrder(input: OrderDraft, signal: AbortSignal): Promise<SaveResult>",
          "evidence": []
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "edit",
      "from": "form",
      "to": "draft",
      "kind": "write",
      "label": "setQuantity(value)",
      "evidence": []
    },
    {
      "id": "calculate",
      "from": "draft",
      "to": "domain",
      "kind": "call",
      "label": "calculateTotal(draft)",
      "evidence": []
    },
    {
      "id": "preview-update",
      "from": "domain",
      "to": "preview",
      "kind": "return",
      "label": "total → 표시 값",
      "evidence": []
    },
    {
      "id": "validate",
      "from": "form",
      "to": "domain",
      "kind": "call",
      "label": "validateQuantity(snapshot)",
      "evidence": []
    },
    {
      "id": "validation-error",
      "from": "domain",
      "to": "form",
      "kind": "return",
      "label": "fieldErrors → 요청 중단",
      "evidence": [],
      "condition": "수량 오류"
    },
    {
      "id": "optimistic",
      "from": "form",
      "to": "cache",
      "kind": "write",
      "label": "snapshot 저장 + optimisticWrite",
      "evidence": []
    },
    {
      "id": "send",
      "from": "form",
      "to": "api",
      "kind": "call",
      "label": "saveOrder(snapshot, signal)",
      "evidence": []
    },
    {
      "id": "accepted",
      "from": "api",
      "to": "cache",
      "kind": "write",
      "label": "서버 응답 commit",
      "evidence": [],
      "condition": "현재 요청 성공"
    },
    {
      "id": "rejected",
      "from": "api",
      "to": "cache",
      "kind": "write",
      "label": "소유권 검사 후 rollback",
      "evidence": [],
      "condition": "현재 요청 실패"
    },
    {
      "id": "failure-ui",
      "from": "api",
      "to": "form",
      "kind": "return",
      "label": "업무 오류 + pending=false",
      "evidence": [],
      "condition": "실패"
    },
    {
      "id": "dirty-reset",
      "from": "api",
      "to": "draft",
      "kind": "write",
      "label": "일치하는 제출본만 markSaved",
      "evidence": [],
      "condition": "응답 후 추가 편집 없음"
    },
    {
      "id": "rows",
      "from": "cache",
      "to": "table",
      "kind": "subscribe",
      "label": "목록 구독자에게 새 rows 전달",
      "evidence": [],
      "condition": "OrdersTable 마운트 상태"
    },
    {
      "id": "cancel",
      "from": "form",
      "to": "api",
      "kind": "cleanup",
      "label": "abort(signal), 소유권 종료",
      "evidence": []
    }
  ],
  "scenarios": [
    {
      "id": "change",
      "title": "수량 변경",
      "entry": "form",
      "event": "change(quantity)",
      "steps": [
        {
          "edge": "edit",
          "effect": "사용자 입력으로 draft.quantity와 dirty 변경"
        },
        {
          "edge": "calculate",
          "effect": "변경된 draft로 금액을 순수 계산"
        },
        {
          "edge": "preview-update",
          "effect": "PricePreview의 표시 값이 바뀜. 실제 DOM 커밋은 미측정"
        }
      ],
      "outcome": "네트워크 없이 미리보기 값 변경",
      "limitations": []
    },
    {
      "id": "save-success",
      "title": "저장 성공",
      "entry": "form",
      "event": "submit → success",
      "steps": [
        {
          "edge": "validate",
          "effect": "제출 스냅샷의 수량을 검사"
        },
        {
          "edge": "optimistic",
          "effect": "이전 캐시와 요청 소유자를 보관하고 목록 캐시에 임시 값 반영"
        },
        {
          "edge": "rows",
          "effect": "현재 마운트된 목록 구독자에게만 반영"
        },
        {
          "edge": "send",
          "effect": "제출 입력을 변경하지 않고 요청. 자동 재시도는 하지 않음"
        },
        {
          "edge": "accepted",
          "effect": "요청 소유권이 같을 때 서버 정규화 값으로 캐시 확정"
        },
        {
          "edge": "dirty-reset",
          "effect": "제출 후 사용자가 다시 수정하지 않은 draft만 저장 완료 처리"
        }
      ],
      "outcome": "서버 값 확정 · 새 편집은 보존",
      "limitations": []
    },
    {
      "id": "save-failure",
      "title": "저장 실패 · 복원",
      "entry": "form",
      "event": "submit → failure",
      "steps": [
        {
          "edge": "validate",
          "effect": "제출 스냅샷 검증"
        },
        {
          "edge": "optimistic",
          "effect": "복원할 캐시와 요청 소유자를 기록"
        },
        {
          "edge": "send",
          "effect": "원본 입력을 변경하지 않고 요청"
        },
        {
          "edge": "rejected",
          "effect": "현재 요청이 소유한 낙관적 변경만 복원"
        },
        {
          "edge": "rows",
          "effect": "구독 중인 목록에 복원된 값 전달"
        },
        {
          "edge": "failure-ui",
          "effect": "입력은 유지하고 오류 표시. 다시 제출 가능"
        }
      ],
      "outcome": "dirty draft 보존 · 소유한 임시 캐시만 복원",
      "limitations": []
    },
    {
      "id": "invalid",
      "title": "유효성 오류",
      "entry": "form",
      "event": "submit → invalid",
      "steps": [
        {
          "edge": "validate",
          "effect": "수량 규칙 검사"
        },
        {
          "edge": "validation-error",
          "effect": "오류를 Form에 전달하고 캐시/네트워크 작업은 실행하지 않음"
        }
      ],
      "outcome": "오류 표시 · 외부 상태 변경 없음",
      "limitations": []
    },
    {
      "id": "leave",
      "title": "편집 취소 / 이탈",
      "entry": "form",
      "event": "cancel / unmount",
      "steps": [
        {
          "edge": "cancel",
          "effect": "활성 요청을 취소하고 늦은 응답의 소유권을 종료"
        }
      ],
      "outcome": "구독 해제와 늦은 응답 정책은 실제 코드에서 추가 검증",
      "limitations": []
    }
  ],
  "invariants": [],
  "limitations": [
    "실제 프로젝트의 분석 결과가 아닌 제안된 주문 편집 예시입니다.",
    "서버 내부 처리, 브라우저 스케줄러 및 실제 DOM 커밋은 기록하지 않았습니다.",
    "두 페이지는 라우트 대안입니다. 목록 캐시는 공유하지만 목록 화면 갱신은 해당 뷰가 마운트되어 구독할 때만 발생합니다.",
    "낙관적 목록 갱신은 사용자 승인과 동시 수정 정책을 전제로 한 예시입니다. 실패 시 제출 전 스냅샷으로 복원하되 최신 요청 소유권을 먼저 확인합니다.",
    "표시한 이름·시그니처는 제안입니다. OrderFilter 등 범위 밖 타입의 전체 정의와 구현은 생략했습니다."
  ]
}
